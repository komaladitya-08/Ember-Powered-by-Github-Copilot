#!/bin/sh
# Starts Ember (installed in /opt/ember). "ember doctor" checks this machine and explains
# anything that needs fixing; it works without a display too.
APP=/opt/ember/ember
# Ember needs X11 (GNOME on Xorg): never let Chromium pick Wayland.
case "$1" in
  doctor)
    shift
    # Chromium won't start as root with its sandbox (sudo ember doctor). The check-up shows
    # no web content, so as root it runs without the sandbox; Ember itself never does.
    nosandbox=
    if [ "$(id -u)" = 0 ]; then nosandbox=--no-sandbox; fi
    # No GPU either: nothing is drawn, and without a display Chromium's GL set-up only prints errors.
    if [ -z "$DISPLAY" ]; then exec "$APP" --doctor --ozone-platform=headless --disable-gpu $nosandbox "$@"; fi
    exec "$APP" --doctor --ozone-platform=x11 --disable-gpu $nosandbox "$@"
    ;;
  -h|--help)
    echo "usage: ember [doctor | --show-settings]"
    echo "  ember              start Ember (it stays beside your cursor; Ctrl+Alt+E opens its settings)"
    echo "  ember doctor       check this computer and explain anything that needs fixing"
    echo "  ember --show-settings   start and open the settings window"
    exit 0
    ;;
esac
# Without a display (an ssh session without -X, a text console) Chromium prints only its own error.
if [ -z "$DISPLAY" ]; then
  echo "Ember needs your desktop session (no display here). Run it from a terminal inside GNOME, or run 'ember doctor'." >&2
  exit 1
fi
exec "$APP" --ozone-platform=x11 "$@"
