{
  "id": "autonomy-risky-still-asks",
  "title": "Still asks before replacing a note while working without asking",
  "instruction": "Replace everything in my notes with \"Hello from Ember\" and save.",
  "app": {
    "editor": "{tmp}/notes.txt"
  },
  "setup": [
    {
      "file": "{tmp}/notes.txt",
      "content": "Standup notes\n- ship M9\n"
    }
  ],
  "user": {
    "autonomy": true
  },
  "hands": [
    "cursor"
  ],
  "script": [
    {
      "tool": "perceive_window"
    },
    {
      "tool": "type_text",
      "args": {
        "id": {
          "find": "^text"
        },
        "text": "Hello from Ember",
        "mode": "replace"
      }
    },
    {
      "tool": "press_keys",
      "args": {
        "keys": "ctrl+s"
      }
    },
    {
      "tool": "finish_task",
      "args": {
        "success": true,
        "summary": "Replaced and saved."
      }
    }
  ],
  "expect": [
    {
      "file": "{tmp}/notes.txt",
      "contains": "Hello from Ember",
      "notContains": "Standup"
    },
    {
      "audit": {
        "event": "decision",
        "kind": "text",
        "verdict": "confirm"
      }
    },
    {
      "audit": {
        "event": "confirm",
        "kind": "text",
        "answer": "once"
      }
    },
    {
      "audit": {
        "event": "decision",
        "kind": "text",
        "autonomy": true
      },
      "absent": true
    }
  ],
  "tags": [
    "editor",
    "tier1",
    "tier3",
    "autonomy",
    "safety"
  ]
}
