{
  "id": "bench-user-says-no",
  "title": "Takes no for an answer",
  "instruction": "Turn on Night Light in the test bench.",
  "app": {
    "fixture": "bench"
  },
  "user": {
    "answer": "deny"
  },
  "script": [
    {
      "tool": "perceive_window"
    },
    {
      "tool": "toggle",
      "args": {
        "id": {
          "find": "^toggle button"
        },
        "on": true
      }
    },
    {
      "tool": "finish_task",
      "args": {
        "success": false,
        "summary": "You said no, so I left it."
      }
    }
  ],
  "expect": [
    {
      "audit": {
        "event": "confirm",
        "answer": "deny"
      }
    },
    {
      "event": {
        "event": "toggled",
        "name": "Night Light"
      },
      "absent": true
    }
  ],
  "tags": [
    "bench",
    "safety",
    "consent"
  ]
}
