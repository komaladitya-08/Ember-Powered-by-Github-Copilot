{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ember/characters": ["packages/characters/src/index.ts"],
      "@ember/bubble": ["packages/bubble/src/index.ts"],
      "@ember/motion": ["packages/motion/src/index.ts"]
    }
  },
  "include": ["app", "packages", "demo", "test", "eval", "vitest.config.ts"]
}
