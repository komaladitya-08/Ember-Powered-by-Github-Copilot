+        private static bool IsAppContainerProcess()
+        {
+            IntPtr token = IntPtr.Zero;
+            bool observed = false;
+            try
+            {
+                if (OpenProcessToken(GetCurrentProcess(), 0x8, out token))
+                {
+                    observed = GetTokenInformation(token, 29, out uint value, 4, out uint returned)
+                        && returned == 4 && value == 1;
+                }
+            }
+            catch
+            {
+                // A failed or unsupported token observation retains the original registration failure.
+                observed = false;
+            }
+            finally
+            {
+                if (token != IntPtr.Zero)
+                {
+                    try { if (!CloseHandle(token)) observed = false; }
+                    catch { observed = false; }
+                }
+            }
+
+            return observed;
+        }
